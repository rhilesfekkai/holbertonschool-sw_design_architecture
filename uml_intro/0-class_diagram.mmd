classDiagram
    class Library {
        +add_book(Book book)
        +register_user(User user)
        +create_loan(Book book, User user)
    }

    class Book {
        +title: str
        +author: str
        +available: bool
        +mark_as_unavailable()
        +mark_as_available()
    }

    class User {
        +name: str
        +email: str
    }

    class Loan {
        +start_date: str
        +end_date: str
        +close_loan()
    }

    Library "1" *-- "0..*" Book
    Library "1" *-- "0..*" User
    Library "1" *-- "0..*" Loan
    Loan "0..*" --> "1" Book : book
    Loan "0..*" --> "1" User : user
